#cloud-config
# The #cloud-config header is essential for cloud-init to recognize the file.

autoinstall:
  # Specify the version of the autoinstall configuration format.
  version: 1
  refresh-installer:
    update: true
  # Identity configuration (hostname, user account)
  identity:
    hostname: ubuntu          # Set the hostname for the installed system
    password: @passsword@
    username: @username@          # Set the default user account name

  # SSH configuration
  ssh:
    allow-pw: true          # Allow password authentication for SSH (use with caution)
    install-server: true    # Ensure the OpenSSH server is installed
    ssh_authorized_keys:    # Optional: Add SSH public keys for key-based authentication
      -  ssh-rsa  aedu@clawfinger

  # Network configuration (uses Netplan format)
  network:
    network:
      version: 2
      ethernets:
        eth0:               # Assumes your primary network interface is named eth0
          dhcp4: true       # Enable DHCP for IPv4

      # Example for static IP configuration (uncomment and modify if needed)
      # ethernets:
      #   eth0:
      #     dhcp4: no
      #     addresses: [192.168.1.100/24]
      #     routes:
      #       - to: default
      #         via: 192.168.1.1
      #     nameservers:
      #       addresses: [8.8.8.8, 8.8.4.4]

  # Storage configuration (disk partitioning and filesystem layout)
  storage:
    layout:
      name: direct            # Simple layout: Use the first available disk directly
                              # Other options include 'lvm', 'custom', etc.
                              # Be cautious: 'direct' typically wipes the disk.

  # Packages to install during the installation
  packages:
    - curl
    - wget
    - vim
    - net-tools

  # # --- Keyboard Layout Configuration ---
  # keyboard:
  #   layout: ch                # Set the base layout to Swiss (ch)
  #   variant: de               # Set the variant to German (de) within the Swiss layout

  # --- Locale Configuration ---
  locale: de_CH.UTF-8       # Set the system locale to German (Switzerland) with UTF-8 encoding


